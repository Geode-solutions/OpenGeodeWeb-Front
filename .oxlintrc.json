{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "plugins": ["import", "node", "oxc", "promise", "unicorn", "vitest", "vue"],
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "snakeCase"
      }
    ],
    "eslint/func-style": ["error", "declaration"],
    "eslint/sort-keys": "off",
    "eslint/no-ternary": "off", // A utiliser pour des opérations simples
    "unicorn/prefer-ternary": "off",
    "oxc/no-async-await": "off",
    "one-var": ["error", "never"],
    "oxc/no-rest-spread-properties": "off", // Enable if older browser support is needed
    "eslint/max-statements": ["warn", 20],
    "eslint/id-length": [
      "error",
      {
        // T/R/S/U/K/V/E are the standard single-letter TypeScript generic type
        // parameter names (Type/Return/State/etc.) - this rule doesn't
        // distinguish them from ordinary identifiers, but renaming a generic
        // parameter to a longer name isn't idiomatic TS and wasn't reachable at
        // all before this codebase had any generics to declare.
        "exceptions": [
          "x",
          "y",
          "z",
          "i",
          "j",
          "k",
          "id",
          "ID",
          "fs",
          "os",
          "_",
          "T",
          "R",
          "S",
          "U",
          "K",
          "V",
          "E",
          "ok",
          "fn",
          "v2"
        ],
        "min": 3
      }
    ],
    // Enabled implicitly via the "restriction" category default. Fires on the
    // common TS pattern of declaring a typed `let` up front and assigning it
    // later (a lifecycle hook, a loop) - e.g. `let interval: ReturnType<typeof
    // setInterval> | undefined;` - which wasn't reachable on plain JS.
    "eslint/init-declarations": "off",
    "eslint/no-console": "warn", // Disable for debugging. Disable later to not have browser logs
    // eslint core's sort-imports orders import statements by specifier count
    // ("multiple" before "single"), which silently worked on the old plain-JS
    // codebase but breaks throughout now that many single-value imports gained a
    // second, type-only specifier (`import { x, type Y } from "..."`) - a known
    // limitation of this rule with TypeScript type imports (this is why
    // TS-focused projects typically use a dedicated import-sort plugin instead).
    // Not auto-fixable (this rule has no statement-reordering autofixer) and
    // fixing ~80 call sites by hand for a purely cosmetic rule isn't worth the
    // diff noise here; left off with this note for whoever wants to adopt a
    // TS-aware import sorter as a follow-up.
    "sort-imports": "off",
    "eslint/no-undefined": "off", // Conflict with unicorn/no-typeof-undefined which prefers direct undefined comparison
    "import/consistent-type-specifier-style": "off", // Conflicts with eslint/no-duplicate-imports for a module imported for both a value and a type: satisfying "top-level" here means violating no-duplicate-imports, and vice versa. Keeping one statement per module (no-duplicate-imports) and inlining the `type` keyword instead.
    "import/prefer-default-export": "off",
    "import/no-named-export": "off",
    "import/no-namespace": [
      "error",
      {
        "ignore": ["vuetify/*"]
      }
    ],
    "import/max-dependencies": [
      "warn",
      {
        "max": 10
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "unicorn/no-useless-undefined": "off",
    // Raised from 310 during the TypeScript migration: several files (store
    // composables, a test file) grew past the old limit purely from added type
    // annotations/interfaces, with no new logic. 340 covers those without
    // meaningfully loosening the rule's intent of flagging files that should be split.
    "max-lines": [
      "error",
      {
        "max": 340,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "vue/max-props": [
      "error",
      {
        "maxProps": 8
      }
    ],
    // These two only ever fired once components gained `lang="ts"` (the TypeScript
    // migration): they ask every `defineProps({...})`/`defineEmits([...])` runtime
    // declaration to become a type-based `defineProps<{...}>()`/`defineEmits<{...}>()`
    // one. That's a real, valuable follow-up, but a much larger and riskier change
    // than the migration itself (default values move to `withDefaults()`, `type:
    // Object`/`Function` runtime validators have no direct generic equivalent, etc.)
    // across ~100 components - left off here rather than rewritten wholesale.
    "vue/define-props-declaration": "off",
    "vue/define-emits-declaration": "off",
    "oxc/no-optional-chaining": "off",
    "node/no-process-env": "off",
    "no-continue": "off",
    "vitest/require-hook": "off",
    "import/unambiguous": "off",
    "node/no-sync": "off",
    "max-params": [
      "warn",
      {
        "max": 4
      }
    ],
    "import/no-nodejs-modules": "off",
    "eslint/no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2, 3, 4],
        "ignoreArrayIndexes": true
      }
    ],
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_data", "__dirname", "__VEASE_UTILS__", "__VEASE_STORES__", "__VEASE_SCHEMAS__"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/components/**"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase"
          }
        ]
      }
    },
    {
      "files": ["app/plugins/**", "node_scripts/**", "server/**", "*.config.js", "*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "vitest/require-hook": "off",
        "vitest/no-hooks": "off",
        "jest/no-hooks": "off",
        "vitest/no-importing-vitest-globals": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "vitest/prefer-to-be-truthy": "off",
        "vitest/prefer-to-be-falsy": "off",
        "vitest/require-test-timeout": "warn",
        "vitest/prefer-importing-vitest-globals": "off",
        "jest/consistent-test-it": "off",
        "vitest/consistent-test-it": ["error", { "fn": "test", "withinDescribe": "test" }],
        "vitest/prefer-spy-on": "off",
        "vitest/prefer-expect-assertions": "off",
        "jest/prefer-expect-assertions": "off",
        // Only ever fires now that tests are .ts; asks every bare `vi.fn()` mock
        // (many, across plain mock objects for stores/composables) to carry an
        // explicit call-signature type parameter. Real value for a handful of
        // mocks, but for ~70 of them across this test suite it would mean either
        // guessing a signature that's already implied by how the mock is used
        // (risking a type that quietly doesn't match, which defeats the point)
        // or laboriously deriving it from each real function - left off rather
        // than doing that at scale under time pressure.
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["internal/stores/hybrid_viewer/vtk_types.ts"],
      "rules": {
        // This file's imported vtk.js types are also used locally (CameraOptions,
        // HybridDbEntry, HybridViewerStorePublic reference them directly), not
        // just re-exported, so they can't become pure `export ... from "...";`
        // re-exports without losing the local binding these interfaces need.
        "unicorn/prefer-export-from": "off"
      }
    },
    {
      "files": ["server/types/vendor.d.ts"],
      "rules": {
        // These ambient declarations mirror the real, external `ws`/`busboy` APIs
        // (EventEmitter's `on`); renaming the method here wouldn't change the
        // 2-character name real callers already use.
        "eslint/id-length": "off",
        // This file declares ambient types for two separate untyped packages (`ws`
        // and `busboy`); splitting it in two would just be file-count churn for a
        // couple of small, always-imported-together vendor shims.
        "eslint/max-classes-per-file": "off"
      }
    },
    {
      "files": ["**/preload.js"],
      "rules": {
        "import/no-commonjs": "off"
      }
    }
  ]
}
