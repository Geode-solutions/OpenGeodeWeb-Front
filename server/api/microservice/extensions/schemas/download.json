{
  "route": "/download",
  "methods": ["POST"],
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "extensionFileName": {
      "type": "string"
    }
  },
  "required": ["projectName", "url", "extensionFileName"],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "statusCode": {
        "type": "integer"
      }
    },
    "required": ["statusCode"],
    "additionalProperties": false
  }
}
